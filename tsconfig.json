{
  // The repository-root TypeScript project owns exactly one surface: the
  // operational scripts under `scripts/`. It is a Node configuration, not a
  // repository-wide one — the runtime-neutral half lives in
  // `tsconfig.base.json`, which every project here extends.
  //
  // Until this cycle this file was a Next project configuration (DOM libs, JSX,
  // bundler resolution, the Next plugin) that `apps/api` extended, which is how
  // a Fastify server came to have `HTMLElement` in scope. It also declared an
  // `include` of `**/*.ts` that nothing ever compiled: `pnpm typecheck` is
  // `turbo run typecheck`, turbo runs per-workspace scripts, and no root task
  // is declared. `scripts/rc-prod-clone.ts` sat inside that phantom program and
  // was checked by nothing. `pnpm typecheck:root` now compiles it for real.
  //
  // A solution-style config (`files: []` plus `references`) was rejected: `tsc
  // -b` requires every referenced project to be composite, and the web, tools
  // and test projects are not. A bare `extends` with no `module` was rejected
  // too — an editor opening a file under it would fall back to
  // `moduleResolution: classic` and fail to resolve any import.
  //
  // `scripts/rc-prod-clone.ts` imports `@luke/api`, whose manifest points
  // `main`/`types` at `./src/index.ts`, so this program typechecks the API's
  // sources. That is a property of that package's manifest, not of this config.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "build"]
}
