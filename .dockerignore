# Version control
.git
.gitignore

# Node
node_modules
**/node_modules

# Next.js build output (rebuilt inside Docker)
apps/web/.next

# TypeScript build info
**/*.tsbuildinfo
**/tsconfig.tsbuildinfo

# Compiled output (rebuilt inside Docker)
apps/api/dist
apps/api/dist-scripts
packages/core/dist
packages/db/dist
packages/nav/dist
packages/calendar/dist

# Turborepo cache
**/.turbo

# The Prisma client, regenerated inside Docker by `@luke/db`'s build. Copying a
# host-generated one in would ship whatever schema the host last had.
packages/db/src/generated

# Local dev databases
**/*.db
**/*.db-shm
**/*.db-wal

# Local secrets & env files
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Editor & OS
.DS_Store
.vscode
*.swp

# Test output, including the Playwright storageState of an authenticated session
coverage
apps/web/playwright-report
apps/web/test-results
apps/web/.vitest-attachments
apps/web/tests/.auth

# Logs
**/*.log

# Docs
docs/
*.md

# Local tooling state: Claude Code, git hooks, planning notes, session memory
.claude
.husky
.planning
.remember

# External apps
EXTERNAL_APPS/
