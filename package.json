{
  "name": "@luke/monorepo",
  "version": "2.1.3",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:integration:local": "pnpm test:db:up && TEST_DATABASE_URL=postgresql://luke:luke_test@localhost:5434/luke_test pnpm test:integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "deps:latest": "pnpm update --latest",
    "sync-version": "node scripts/sync-version.js",
    "sync-version:check": "node scripts/sync-version.js --check",
    "db:seed": "pnpm --filter @luke/api db:seed",
    "check:drift": "tsx tools/scripts/check-skill-integrity.ts && tsx tools/scripts/check-docs-integrity.ts",
    "codemod:eliminate-urls": "tsx tools/codemods/eliminate-hardcoded-urls.ts",
    "codemod:check-urls": "tsx tools/codemods/eliminate-hardcoded-urls.ts --dry-run",
    "release:prepare": "bash scripts/release-prepare.sh",
    "rc:clone": "tsx scripts/rc-prod-clone.ts",
    "changelog": "git-cliff",
    "changelog:bump": "git-cliff --unreleased --prepend CHANGELOG.md",
    "changelog:tag": "git-cliff --unreleased --prepend CHANGELOG.md",
    "prepare": "husky",
    "security:sast": "semgrep scan --config .semgrep/rules/mutation-requires-permission.yml; semgrep scan --config p/typescript --config p/nextjs --config p/nodejs --config p/react --config p/sql-injection --error && semgrep scan --config .semgrep/rules/ --severity ERROR --error",
    "security:secrets": "gitleaks detect --source .",
    "security:deps": "osv-scanner scan -r .",
    "security": "pnpm security:sast && pnpm security:secrets && pnpm security:deps"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@luke/api": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-luke": "workspace:*",
    "git-cliff": "^2.13.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
