{
  "name": "@luke/monorepo",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "sh scripts/assert-no-dev.sh && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "sh scripts/assert-no-dev.sh && turbo run typecheck",
    "typecheck:test": "sh scripts/assert-no-dev.sh && turbo run typecheck:test",
    "lint:tools": "eslint tools/ scripts/ eslint.config.mjs commitlint.config.js",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "typecheck:root": "sh scripts/assert-no-dev.sh && turbo run build --filter=@luke/core --filter=@luke/nav --filter=@luke/calendar --filter=@luke/api && tsc -p tsconfig.json",
    "test": "sh scripts/assert-no-dev.sh && turbo run test",
    "test:browser": "sh scripts/assert-no-dev.sh && turbo run test:browser",
    "test:module-contract": "sh scripts/assert-no-dev.sh && turbo run build --filter=@luke/core --filter=@luke/api && node packages/core/test/module-contract.cjs && node apps/api/test/module-contract.cjs",
    "test:integration": "sh scripts/assert-no-dev.sh && turbo run test:integration",
    "test:integration:local": "pnpm test:db:up && TEST_DATABASE_URL=postgresql://luke:luke_test@localhost:5434/luke_test pnpm test:integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "backup:open": "node scripts/lukebak-open.mjs",
    "db:seed": "pnpm --filter @luke/api db:seed",
    "check:platform": "tsx tools/scripts/check-platform-integrity.ts",
    "check:overrides": "tsx tools/scripts/check-override-consumers.ts",
    "check:tsconfig": "tsx tools/scripts/check-tsconfig-integrity.ts",
    "check:workflows": "tsx tools/scripts/check-workflow-branches.ts && tsx tools/scripts/check-workflow-paths.ts",
    "check:drift": "tsx tools/scripts/check-skill-integrity.ts && tsx tools/scripts/check-docs-integrity.ts && pnpm check:platform && pnpm check:overrides && pnpm check:tsconfig && pnpm check:workflows",
    "test:tools": "node --import tsx --import ./tools/scripts/lib/isolateGitEnv.ts --test \"tools/scripts/**/*.test.ts\"",
    "release:prepare": "bash scripts/release-prepare.sh",
    "rc:clone": "tsx scripts/rc-prod-clone.ts",
    "changelog": "git-cliff",
    "prepare": "husky",
    "postinstall": "pnpm --filter @luke/db exec prisma generate",
    "security:sast": "semgrep scan --config p/typescript --config p/nextjs --config p/nodejs --config p/react --config p/sql-injection --error && semgrep scan --config .semgrep/rules/ --severity ERROR --error",
    "security:sast:test": "sh scripts/semgrep-test.sh",
    "security:secrets": "gitleaks detect --source .",
    "security:deps": "osv-scanner scan -r .",
    "security": "pnpm security:sast && pnpm security:secrets && pnpm security:deps"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@luke/api": "workspace:*",
    "@trpc/client": "^11.19.0",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-luke": "workspace:*",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  }
}
