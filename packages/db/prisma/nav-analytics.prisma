
// ─── Portfolio Analytics Sync ───────────────────────────────────────────────
//
// Analytics replicas of the NAV tables used by the order portfolio query.
// Prefix nav_pf_ (portfolio) to distinguish them from the nav_* entity-dual tables.
// Updated by the sync service (background every 5 min + manual trigger).
// NO soft-delete, NO local entity: these are pure read-only replicas for the app.

/// Sync state tracker per NAV portfolio table. navRowversion = CONVERT(BIGINT, MAX(timestamp)) from last SQL Server sync. 0 for full-refresh tables.
model NavPfSyncState {
  /// Table name used as PK (e.g. "nav_pf_sales_header").
  tableName      String    @id
  /// Last NAV rowversion processed. 0 for full-refresh tables (date_prenotazione, ddt_picking).
  lastRowversion BigInt    @default(0)
  lastSyncedAt   DateTime?
  /// Number of rows present after the last sync.
  rowCount       Int       @default(0)
  /// Duration of the last sync in milliseconds.
  lastDurationMs Int?

  @@map("nav_pf_sync_state")
}

/// Read-only replica of [Company$Sales Header] from NAV. Synced incrementally via rowversion.
model NavPfSalesHeader {
  /// NAV order number (source `No_`), used as the primary key.
  no_                        String    @id
  /// NAV document type code (order/invoice/credit memo/...); part of the composite key shared with NavPfSalesLine.
  documentType               Int
  orderDate                  DateTime?
  /// Soft reference to NavPfCustomer.no_ — the customer the goods are sold to.
  sellToCustomerNo           String?
  /// Soft reference to NavPfCustomer.no_ — the customer to be invoiced.
  billToCustomerNo           String?
  billToName                 String?
  /// Soft reference to NavPfSalesperson.code.
  salespersonCode            String?
  /// Soft reference to NavPfSalesperson.code — area manager assigned to the order.
  areaManagerCode            String?
  subject1                   String?
  subject2                   String?
  currencyCode               String?
  /// Soft reference to NavPfShipToAddress.code (composite with sellToCustomerNo).
  shipToCode                 String?
  shipToName                 String?
  shipToName2                String?
  shipToAddress              String?
  shipToAddress2             String?
  shipToCity                 String?
  shipToPostCode             String?
  shipToCounty               String?
  /// Soft reference to NavPfShipmentMethod.code.
  shipmentMethodCode         String?
  /// Soft reference to NavPfTransportReason.code.
  transportReasonCode        String?
  shippingAgentCode          String?
  shippingAgentServiceCode   String?
  paymentTermsCode           String?
  paymentMethodCode          String?
  invoiceDiscountCalculation String?
  invoiceDiscountValue       Float?
  /// NAV boolean flag (0/1): whether the order is a consignment order.
  consignment                Int?
  rightOnReturnPct           Float?
  note                       String?
  campaignNo                 String?
  securitiesReceived         String?
  /// NAV boolean flag (0/1), order-anomaly review workflow.
  anomalous                  Int?
  /// NAV boolean flag (0/1), order-anomaly review workflow (complementary to anomalous).
  notAnomalous               Int?
  anomalousDate              DateTime?
  /// NAV boolean flag (0/1): whether the order has been reviewed/checked.
  checked                    Int?
  checkedDate                DateTime?
  /// Soft reference to NavPfBudgetHeader.no_.
  budgetNo                   String?
  courseDate                 DateTime?
  /// Cross-reference to the corresponding KIMO-FASHION sales order (see NavKimoSalesHeader.assignedSalesDocumentNo).
  kimoFashionSoNo            String?
  orderType                  Int?
  /// NAV boolean flag (0/1): expedited shipping requested.
  fastShipping               Int?
  commissionGroupCode        String?
  /// Soft reference to NavPfGeoZone.code.
  geographicalZone           String?
  /// NAV selling season code; correlates with the Luke Season entity for portfolio filtering.
  sellingSeasonCode          String?
  /// NAV Shortcut Dimension 2 — typically the brand/trademark dimension, used for portfolio filtering.
  shortcutDimension2Code     String?
  customerPostingGroup       String?
  navRowversion              BigInt    @default(0)

  @@index([sellingSeasonCode])
  @@index([shortcutDimension2Code])
  @@index([sellingSeasonCode, shortcutDimension2Code])
  @@index([salespersonCode])
  @@index([sellToCustomerNo])
  @@map("nav_pf_sales_header")
}

/// Read-only replica of [Company$Sales Line] from NAV. PK is composite (documentType, documentNo, lineNo).
model NavPfSalesLine {
  documentType             Int
  /// Soft reference to NavPfSalesHeader.no_ — composite PK together with documentType, lineNo.
  documentNo               String
  lineNo                   Int
  /// NAV sales line type code (e.g. item / G/L account / comment).
  type                     Int?
  /// Item number for this line (when type=Item); soft reference to NavPfItem.no_.
  no_                      String?
  customerOrderRef         String?
  reference                String?
  genBusPostingGroup       String?
  vatBusPostingGroup       String?
  unitOfMeasure            String?
  /// Soft reference to NavPfVariableCode.variableCode — the colour code for this line.
  constantVariableCode     String?
  assortmentCode           String?
  deleteReason             String?
  salesPurchaseStatusCode  String?
  salesPurchaseStatusItem  String?
  deleteDate               DateTime?
  customerPriceGroup       String?
  averageUnitPrice         Float?
  noOfPairs                Float?
  quantity                 Float?
  lineAmount               Float?
  invDiscountAmount        Float?
  quantityShipped          Float?
  quantityInvoiced         Float?
  returnQtyReceived        Float?
  subject1Commission       Float?
  subject2Commission       Float?
  subject3Commission       Float?
  subject4Commission       Float?
  areaManagerCommission    Float?
  salespersonCommission    Float?
  returnReasonCode         String?
  requestedDeliveryDate    DateTime?
  lineDiscountPct          Float?
  discount1Pct             Float?
  discount2Pct             Float?
  discount3Pct             Float?
  locationCode             String?
  /// Soft reference to NavPfItem.modelItemNo — the model item this SKU line belongs to.
  modelCrossReference      String?
  /// Soft reference to NavPfItem.constantAssortmentVarGrp.
  constantAssortmentVarGrp String?
  navRowversion            BigInt    @default(0)

  @@id([documentType, documentNo, lineNo])
  @@index([documentNo])
  @@index([no_])
  @@index([constantVariableCode])
  @@map("nav_pf_sales_line")
}

/// Read-only replica of [Company$Sales Header Extension] from NAV. Extends NavPfSalesHeader with additional fields.
model NavPfSalesHeaderExt {
  /// Part of the composite PK, matches NavPfSalesHeader.documentType for the extended header.
  documentType            Int
  /// Soft reference to NavPfSalesHeader.no_ — composite PK together with documentType.
  documentNo              String
  warehouseSpecialityCode String?
  subject3                String?
  subject4                String?
  oldOrderNo              String?
  specialRequests         String?
  navRowversion           BigInt  @default(0)

  @@id([documentType, documentNo])
  @@map("nav_pf_sales_header_ext")
}

/// Read-only replica of [Company$Item] from NAV — only Configurator Relation 2 (models) and 3 (SKUs). Relation 2 used as Sales Line.No_ key; Relation 3 for carry_over/landed_cost/must_buy aggregations.
model NavPfItem {
  /// NAV item number.
  no_                       String    @id
  description               String?
  description2              String?
  /// NAV Configurator Relation level: 2 = model (used as NavPfSalesLine.no_ key), 3 = SKU (used for carry_over/landed_cost/must_buy aggregations).
  configuratorRelation      Int?
  /// Soft reference to NavPfItem.no_ of the parent model item (populated on Relation 3 / SKU rows).
  modelItemNo               String?
  /// Soft reference to NavPfVariableCode.variableCode — the colour code for this SKU.
  variableCode01            String?
  /// NAV boolean flag (0/1); business meaning not further documented upstream.
  smu                       Int?
  /// NAV boolean flag (0/1): item is a carry-over from a prior season.
  carryOver                 Int?
  /// NAV boolean flag (0/1): item is planned as a future carry-over.
  futureCarryOver           Int?
  /// NAV boolean flag (0/1): item is sold out.
  soldOut                   Int?
  soldOutDate               DateTime?
  salesPurchaseStatusItem   String?
  salesPurchaseStatusDate   DateTime?
  /// NAV boolean flag (0/1): item is at risk of selling out.
  potentialSoldOut          Int?
  minimumOrderQuantity      Float?
  /// NAV boolean flag (0/1): item is flagged as must-buy.
  mustBuy                   Int?
  standardCost              Float?
  collectionCode            String?
  lineCode                  String?
  seasonTypology            String?
  productFamily             String?
  productSex                String?
  shipmentPriority          String?
  innovationDegree          String?
  heelHeight                String?
  endCustomerPriceGap       String?
  marketSegment             String?
  productTypology           String?
  mainMaterial              String?
  soleMaterial              String?
  /// Soft reference to NavPfVendor.no_.
  vendorNo                  String?
  manufacturer              String?
  advertisingMaterial       String?
  countryRegionOfOriginCode String?
  /// Assortment variable group code; mirrors the same field on NavPfSalesLine.
  constantAssortmentVarGrp  String?
  /// NAV season code; correlates with the Luke Season entity.
  seasonCode                String?
  /// NAV trademark code; correlates with the Luke Brand entity.
  trademarkCode             String?
  navRowversion             BigInt    @default(0)

  @@index([modelItemNo])
  @@index([configuratorRelation])
  @@index([modelItemNo, variableCode01])
  @@index([seasonCode])
  @@index([trademarkCode])
  @@map("nav_pf_item")
}

/// Read-only replica of [Company$Customer] from NAV.
model NavPfCustomer {
  /// NAV customer number — target of soft references from NavPfSalesHeader/NavKimoSalesHeader (sellToCustomerNo/billToCustomerNo) and NavPfShipToAddress (customerNo).
  no_                     String    @id
  name                    String?
  name2                   String?
  address                 String?
  city                    String?
  postCode                String?
  county                  String?
  countryRegionCode       String?
  phoneNo                 String?
  faxNo                   String?
  eMail                   String?
  businessEMail           String?
  contact                 String?
  /// Soft reference to NavPfGeoZone.code.
  geographicalZone        String?
  /// Secondary geographical zone; soft reference to NavPfGeoZone.code.
  geographicalZone2       String?
  /// NAV boolean flag (0/1): customer is flagged as a key account.
  keyAccount              Int?
  warehouseSpecialityCode String?
  languageCode            String?
  /// NAV boolean flag (0/1): customer requires expedited shipment.
  fastShipment            Int?
  /// NAV boolean flag (0/1): customer is blocked from new order assignments.
  blockedForAssignments   Int?
  reasonBlockCode         String?
  paymentMethodCode       String?
  paymentTermsCode        String?
  vatRegistrationNo       String?
  fiscalCode              String?
  currentRisk             String?
  riskRating              String?
  pmFailureAssignedScore  String?
  updatedDate             DateTime?
  updatedType             String?
  dueDate                 DateTime?
  internalValuation       String?
  valuationDate           DateTime?
  reservationPriority     String?
  authorizedStoresNumber  Int?
  /// NAV rating/classification code for store distribution quality; scale not further documented upstream.
  storeDistribution       Int?
  /// NAV rating/classification code for store image quality; scale not further documented upstream.
  storeImage              Int?
  /// NAV store type classification code.
  storeType               Int?
  variousReferences       String?
  homePage                String?
  qualityControl          String?
  /// Legacy customer number from the predecessor "Febos" system, kept for cross-reference.
  oldFebosNo              String?
  /// Legacy customer number from the predecessor "Bridge" system, kept for cross-reference.
  oldBridgeNo             String?
  purchaseGroup           String?
  distributionChannel     String?
  creditManager           String?
  eacLabels               String?
  /// NAV boolean flag (0/1): customer requires a complete/consolidated shipment ("sovracollo completo").
  sovracolloCompleto      Int?
  commissionGroupCode     String?
  /// NAV VAT business posting group (accounting classification).
  vatBusPostingGroup      String?
  /// NAV general business posting group (accounting classification).
  genBusPostingGroup      String?
  /// NAV customer posting group (accounting classification).
  customerPostingGroup    String?
  navRowversion           BigInt    @default(0)

  @@map("nav_pf_customer")
}

/// Read-only replica of [Company$Ship-to Address] from NAV.
model NavPfShipToAddress {
  /// Soft reference to NavPfCustomer.no_ — composite PK together with code.
  customerNo        String
  /// Ship-to address code within the customer; soft-referenced by NavPfSalesHeader.shipToCode.
  code              String
  /// Soft reference to NavPfGeoZone.code.
  geographicalZone2 String?
  countryRegionCode String?
  navRowversion     BigInt  @default(0)

  @@id([customerNo, code])
  @@index([customerNo])
  @@map("nav_pf_ship_to_address")
}

/// Read-only replica of [Company$Variable Code] from NAV. Contains colour descriptions keyed by variableGroup+variableCode.
model NavPfVariableCode {
  /// Variable code category (e.g. colour); composite PK together with variableCode.
  variableGroup String
  /// Code soft-referenced by NavPfSalesLine.constantVariableCode and NavPfItem.variableCode01.
  variableCode  String
  description   String?
  navRowversion BigInt  @default(0)

  @@id([variableGroup, variableCode])
  @@map("nav_pf_variable_code")
}

/// Read-only replica of [Company$Salesperson/Purchaser] from NAV.
model NavPfSalesperson {
  /// NAV salesperson/purchaser code — target of soft references from NavPfSalesHeader.salespersonCode/areaManagerCode and NavKimoSalesHeader.salespersonCodeNav.
  code          String  @id
  name          String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_salesperson")
}

/// Read-only replica of [Company$Geographical Zone] from NAV.
model NavPfGeoZone {
  /// NAV geographical zone code — target of soft references from NavPfSalesHeader.geographicalZone and NavPfCustomer.geographicalZone/geographicalZone2.
  code          String  @id
  description   String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_geo_zone")
}

/// Read-only replica of [Company$Shipment Method] from NAV.
model NavPfShipmentMethod {
  /// NAV shipment method code — target of the soft reference from NavPfSalesHeader.shipmentMethodCode.
  code          String  @id
  description   String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_shipment_method")
}

/// Read-only replica of [Company$Transport Reason Code] from NAV.
model NavPfTransportReason {
  /// NAV transport reason code — target of the soft reference from NavPfSalesHeader.transportReasonCode.
  code          String  @id
  description   String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_transport_reason")
}

/// Read-only replica of [Company$Budget Header] from NAV.
model NavPfBudgetHeader {
  /// NAV budget number — target of the soft reference from NavPfSalesHeader.budgetNo.
  no_           String  @id
  budgetArea    String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_budget_header")
}

/// Read-only replica of [Company$Vendor] from NAV — only fields needed for name lookup in portfolio queries.
model NavPfVendor {
  /// NAV vendor number — target of the soft reference from NavPfItem.vendorNo.
  no_           String  @id
  name          String?
  navRowversion BigInt  @default(0)

  @@map("nav_pf_vendor")
}

/// Pre-aggregation of [Company$Reserv__Assign_ Link] (type 1). Stores MAX(Date Reservation) per (Sales Document No_, Sales Line No_). Full-refresh each sync cycle, scoped to document nos in nav_pf_sales_header.
model NavPfDatePrenotazione {
  /// Soft reference to NavPfSalesHeader.no_ — composite PK together with salesLineNo.
  salesDocumentNo String
  /// Soft reference to NavPfSalesLine.lineNo (scoped to the same salesDocumentNo).
  salesLineNo     Int
  dateReservation DateTime?
  syncedAt        DateTime  @default(now())

  @@id([salesDocumentNo, salesLineNo])
  @@map("nav_pf_date_prenotazione")
}

/// Pre-aggregation of [Company$DDT_Picking Line] JOIN [Company$DDT_Picking Header]. Stores SUM per status per (Order No_, Order Line No_). Full-refresh each sync cycle, scoped to document nos in nav_pf_sales_header.
model NavPfDdtPicking {
  /// Soft reference to NavPfSalesHeader.no_ — composite PK together with orderLineNo.
  orderNo             String
  /// Soft reference to NavPfSalesLine.lineNo (scoped to the same orderNo).
  orderLineNo         Int
  /// SUM of pairs/qty per picking status ("Totale"=total, "Rilasciate"=released, "Aperte"=open,
  /// "DaInviareWmsps"=pending send to WMS-PS, "InviatoWmsps"=sent to WMS-PS, "EvasoWmsps"=fulfilled
  /// by WMS-PS). Applies to this and the following `pairs*` / `qty*` fields: `pairs*` counts shoe pairs, `qty*` counts units.
  pairsTotale         Float?
  qtyTotale           Float?
  pairsRilasciate     Float?
  qtyRilasciate       Float?
  pairsAperte         Float?
  qtyAperte           Float?
  pairsDaInviareWmsps Float?
  qtyDaInviareWmsps   Float?
  pairsInviatoWmsps   Float?
  qtyInviatoWmsps     Float?
  pairsEvasoWmsps     Float?
  qtyEvasoWmsps       Float?
  syncedAt            DateTime @default(now())

  @@id([orderNo, orderLineNo])
  @@index([orderNo])
  @@map("nav_pf_ddt_picking")
}

// ─── KIMO-FASHION Table Replicas ────────────────────────────────────────────
// Prefix nav_kimo_ to distinguish them from nav_pf_* (portfolio).
// Fed by nav-kimo-sync.ts (separate background scheduler).
// Sync state shared with nav_pf_sync_state (same schema, prefix nav_kimo_).

/// Read-only replica of [Company$KIMO-FASHION Sales Order Hdr] from NAV. Incrementally synced via rowversion.
model NavKimoSalesHeader {
  /// NAV internal entry number (not a business document number) — used as PK because KIMO-FASHION rows lack a stable business key.
  entryNo                 BigInt    @id
  /// NAV trademark code; correlates with the Luke Brand entity.
  trademarkCode           String?
  /// NAV selling season code; correlates with the Luke Season entity.
  sellingSeasonCode       String?
  /// Soft reference to NavPfSalesperson.code.
  salespersonCodeNav      String?
  /// NAV sales document number assigned once the KIMO-FASHION order is converted; the counterpart of NavPfSalesHeader.kimoFashionSoNo.
  assignedSalesDocumentNo String?
  /// Soft reference to NavPfCustomer.no_.
  sellToCustomerNo        String?
  createSoDateTime        DateTime?
  releaseSoDateTime       DateTime?
  /// NAV KIMO-FASHION document type code.
  kimoDocumentType        String?
  navRowversion           BigInt    @default(0)

  @@index([trademarkCode])
  @@index([sellingSeasonCode])
  @@index([trademarkCode, sellingSeasonCode])
  @@index([salespersonCodeNav])
  @@index([assignedSalesDocumentNo])
  @@index([sellToCustomerNo])
  @@map("nav_kimo_sales_header")
}

/// Read-only replica of [Company$KIMO-FASHION Sales Order Line] from NAV. PK = Entry No_ (BigInt unique per row). Line No_ does not exist in this NAV table.
model NavKimoSalesLine {
  /// NAV internal entry number (not a business line number) — used as PK since Line No_ does not exist in this NAV table.
  entryNo                BigInt  @id
  /// FK-like reference to NavKimoSalesHeader.entryNo (no @relation — pure replica, joined manually).
  headerEntryNo          BigInt
  /// Item/SKU number; soft reference to NavPfItem.no_.
  no_                    String?
  /// Soft reference to NavPfItem.modelItemNo — the model item this SKU line belongs to.
  modelItemNo            String?
  colorCode              String?
  sizeCode               String?
  quantity               Float?
  lineAmount             Float?
  kimoFashionSoReference String?
  /// NAV sales line type code.
  type                   Int?
  navRowversion          BigInt  @default(0)

  @@index([headerEntryNo])
  @@index([modelItemNo])
  @@map("nav_kimo_sales_line")
}
