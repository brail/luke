{
  // The build tsconfig excludes `__tests__` and `*.test.ts` so they are not
  // emitted to dist — with the side effect that `tsc --noEmit` did not check
  // them at all. This project includes them, without emitting anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
