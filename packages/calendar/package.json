{
  "name": "@luke/calendar",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@luke/core": "workspace:*",
    "googleapis": "^186.0.0",
    "ical-generator": "^11.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
