{
  // Node-only library: the Google Calendar sync and the ICS generator both run
  // in `apps/api`, never in a browser. Neutral `lib: ES2022` from the base; the
  // DOM this config used to carry came from TypeScript's `lib.es2022.full`
  // default, not from anything the package needs.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
