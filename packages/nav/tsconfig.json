{
  // Node-only library: `packages/nav` talks to SQL Server over `mssql` and is
  // consumed exclusively by `apps/api`. It inherits the neutral `lib: ES2022`
  // from the base and adds nothing browser-shaped — until this config named a
  // `lib` at all, TypeScript's `lib.es2022.full` default gave it DOM.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
