# Blocca push di tag se manca la entry corrispondente in CHANGELOG.md
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/v*)
      tag="${remote_ref#refs/tags/}"
      version="${tag#v}"
      if ! grep -q "^## \[$version\]" CHANGELOG.md; then
        echo ""
        echo "❌ Tag $tag mancante in CHANGELOG.md"
        echo "   Aggiungi una entry [$version] o rigenera con:"
        echo "   pnpm changelog:tag --tag $tag"
        echo ""
        exit 1
      fi

      # Le versioni nei package.json devono combaciare col tag: è ciò che finisce
      # nell'immagine e in `/about`. `eslint-plugin-luke` è rimasto a
      # `1.10.0-dev.0` per diverse release senza che nulla protestasse, e
      # `calendar` è nato già fuori sync.
      if ! pnpm sync-version:check > /dev/null 2>&1; then
        echo ""
        echo "❌ package.json non allineati al tag $tag."
        echo "   Dettaglio: pnpm sync-version:check"
        echo "   Correggi:  pnpm sync-version"
        echo ""
        exit 1
      fi
      ;;
  esac
done

# Typecheck prima degli unit test. `test` non tipizza niente e `typecheck` da solo
# copre solo il grafo di build: `apps/api/tsconfig.json` include `src/**` e basta,
# quindi `test/`, `scripts/` e `prisma/` passano unicamente da `typecheck:test`.
# È così che un `Array.prototype.at` è arrivato in CI mentre in locale l'hook
# stampava otto task verdi — che erano verdi, ma non erano quelli.
echo "🔎 Typecheck..."
if ! pnpm turbo run typecheck typecheck:test --output-logs=errors-only; then
  echo ""
  echo "❌ Typecheck fallito — push bloccato."
  echo "   Per saltare (solo se sai perché): git push --no-verify"
  echo ""
  exit 1
fi

# I checker sotto tools/ sono gate di release ma tools/ non è un workspace:
# `turbo run typecheck` non lo vede e tsx esegue il TypeScript senza
# controllarlo. Hanno un tsconfig e un blocco ESLint propri, Node-only.
echo "🔧 Control plane (tools/)..."
if ! pnpm lint:tools || ! pnpm typecheck:tools; then
  echo ""
  echo "❌ Lint/typecheck di tools/ fallito — push bloccato."
  echo "   Per saltare (solo se sai perché): git push --no-verify"
  echo ""
  exit 1
fi

# Unit test prima del push. Non in pre-commit: là serve latenza bassa e il ciclo
# di lavoro ne farebbe a meno. I test di integrazione restano fuori: richiedono
# Docker, e un hook che dipende da un container non è affidabile.
echo "🧪 Unit test..."
if ! pnpm test; then
  echo ""
  echo "❌ Test falliti — push bloccato."
  echo "   Per saltare (solo se sai perché): git push --no-verify"
  echo ""
  exit 1
fi

# Drift di skill e documentazione: ~2s, nessuna infrastruttura. Sta qui e non in
# pre-commit per la stessa ragione degli unit test — là serve latenza bassa.
echo "📐 Drift skill/docs..."
if ! pnpm check:drift; then
  echo ""
  echo "❌ Drift rilevato — push bloccato."
  echo ""
  exit 1
fi
