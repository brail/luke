if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks not found in PATH. Install it with: brew install gitleaks" >&2
  exit 1
fi
if ! command -v semgrep >/dev/null 2>&1; then
  echo "❌ semgrep not found in PATH. Install it with: brew install semgrep (or pipx install semgrep)" >&2
  exit 1
fi

gitleaks protect --staged || exit 1

# ERROR-tier rules only, for speed (<5s): the community ruleset and the
# WARNING rule (luke-mutation-requires-permission) run in CI, not here.
#
# The whole directory, filtered by severity, instead of a file-by-file list:
# a new rule enters all three gates automatically (this hook,
# `security:sast`, `security.yml`). Enumerating them meant three synchronized
# edits for every rule, and forgetting one silently disabled it.
semgrep scan --config .semgrep/rules/ --severity ERROR --error --baseline-commit HEAD
