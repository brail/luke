# External apps (not part of the monorepo)
EXTERNAL_APPS/

# Merchandising domain reference files (Excel, binary)
docs/merchandising-reference/

# Claude Code: the shared skills, hooks and settings are versioned — they are the
# tooling that enforces CLAUDE.md, and keeping them out of git left them on one
# machine, unreviewable and without a backup.
#
# `.claude/*`, not `.claude/`: git does not descend into an excluded directory,
# so no negation below it can bring anything back. `!.claude/skills/**` under
# `.claude/` would be silently inert.
#
# `*` does not match `/`, so the first line excludes only the immediate level
# (settings.local.json, scheduled_tasks.lock, worktrees, .DS_Store) and does not
# stop git descending into the re-included directories.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
# Redundant with `.claude/*` today. It stays because this is the one file that
# must never reach git: it survives a future `!.claude/*.json`.
.claude/settings.local.json

# Planning/roadmap docs (local only)
.planning/

# Session memory written by the `remember` Claude Code plugin (local only)
.remember/

