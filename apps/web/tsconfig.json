{
  // The Next/browser surface, and the only one in this repository that owns
  // DOM, JSX and bundler resolution. Everything below used to arrive by
  // inheritance from the root config, which is why `apps/api` and three
  // Node-only libraries had the DOM in scope; the neutral base carries none of
  // it, so this file states its runtime itself.
  //
  // `extends` must stay present, whatever it points at: Next's
  // `writeConfigurationDefaults` returns early when the user config has an
  // `extends` (or `references`) key, and would otherwise rewrite this file on
  // every `next build` to add its own suggested `lib`/`allowJs`/`target`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "allowArbitraryExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // No workspace package is aliased onto another workspace's sources here.
    // `@luke/core` and `@luke/api` — the only workspace packages this app may
    // depend on under `WORKSPACE_POLICY` (browser runtime: `@luke/calendar` is
    // Node-only and no longer declared) — resolve through their own `exports`
    // maps to their built `dist`, so the published contract is the one
    // actually exercised.
    //
    // `@luke/api` was the last exception. Removing its alias in an earlier
    // cycle changed no program — the manifest pointed `main`/`types` at
    // `./src/index.ts` and published no `exports` map, so the package resolved
    // to raw TypeScript with or without the alias — and the note left here said
    // so: this app would keep typechecking the API's source "until `@luke/api`
    // publishes a build — a package-contract question, not a tsconfig one".
    // That is what changed. The manifest now points at `dist` behind an
    // `exports` map admitting only `.` and `./package.json`, and this program
    // reads 16 built declarations where it used to compile 129 API sources.
    // Turbo's `typecheck.dependsOn: ["^build"]` is what keeps them current.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // The test corpus is owned by tsconfig.test.json. Production and tests were
  // compiled by this one config, which worked only because the tests happen to
  // import from 'vitest' explicitly; the moment a browser test needs
  // test-only types, they would have had to enter the production surface.
  "exclude": [
    "node_modules",
    "tests",
    "src/**/__tests__/**",
    "src/**/__browser__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
