{
  // Typechecks everything OUTSIDE the build graph: `tsconfig.json` includes
  // only `src/**/*`, so `test/`, `scripts/` and `prisma/` never reached tsc.
  // That is how the `datasources` option, removed in Prisma 7, survived in the
  // test helpers and in five CLI scripts without a single report.
  //
  // The quarantine is empty: every suite has been repaired and is covered by
  // the typecheck (see docs/quality-hardening-plan.md).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // `rootDir: src` comes from the build config, and this program includes
    // `test/`, `scripts/`, `prisma/` and the runner configs, all outside it.
    // Nothing is emitted here, so the value only has to stop tsc rejecting the
    // wider include.
    "rootDir": ".",
    // The runtime of these files is Vitest, not Node's module loader: bundler
    // resolution avoids demanding `.js` extensions on relative imports.
    // This is the one place in the repository where a Node surface is
    // deliberately typechecked under bundler semantics, because a bundler is
    // what actually loads it.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/**/*",
    "prisma/**/*.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
