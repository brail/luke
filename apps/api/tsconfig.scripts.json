{
  // The one-off CLI scripts under `scripts/`, built to `dist-scripts/`. Same
  // runtime as the server, so it inherits everything from the build config and
  // changes only where the output goes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-scripts",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["scripts/**/*.ts"]
}
