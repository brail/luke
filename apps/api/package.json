{
  "name": "@luke/api",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/server.ts",
    "dev:types": "tsc --watch --emitDeclarationOnly --preserveWatchOutput",
    "build": "rm -rf dist dist-scripts && tsc && tsc -p tsconfig.scripts.json",
    "start": "node --require ./dist/instrument.js dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap": "tsx --env-file=.env scripts/dev-bootstrap.ts",
    "db:nav-reset": "tsx scripts/nav-reset.ts",
    "db:harden-google-acl": "tsx --env-file=.env scripts/harden-google-calendar-acl.ts",
    "db:complete-stranded-rows": "tsx --env-file=.env scripts/complete-stranded-rows.ts",
    "db:fix-allday-dates": "TZ=Europe/Rome tsx --env-file=.env scripts/fix-allday-event-dates.ts",
    "db:migrate-rbac-section-key": "tsx --env-file=.env scripts/migrate-rbac-controllo-to-control.ts",
    "db:migrate-storage": "tsx --env-file=.env scripts/migrate-storage.ts",
    "db:backfill-asset-derivatives": "tsx --env-file=.env scripts/backfill-asset-derivatives.ts",
    "db:check-config-rows": "tsx --env-file=.env scripts/check-config-rows.ts",
    "db:encrypt-secret-config": "tsx --env-file=.env scripts/encrypt-secret-config.ts",
    "db:repair-auto-revision-photos": "tsx --env-file=.env scripts/repair-auto-revision-photos.ts",
    "db:grant-local-access": "tsx --env-file=.env scripts/grant-local-access.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "10.0.0",
    "@fastify/otel": "^0.21.2",
    "@fastify/proxy-addr": "^5.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@luke/calendar": "workspace:*",
    "@luke/core": "workspace:*",
    "@luke/db": "workspace:*",
    "@luke/nav": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/instrumentation": "^7.10.1",
    "@trpc/server": "^11.19.0",
    "argon2": "^0.45.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "nodemailer": "^10.1.6",
    "p-limit": "^7.3.3",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "0.35.5",
    "tar-stream": "3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
