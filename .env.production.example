# ─────────────────────────────────────────────────────────────────────────────
# Luke — Production Environment Variables
# The variables of docker-compose.prod.yml: set them in Portainer (Stack → Env),
# or copy this file to .env next to the compose file.
# Never put `$` in a value: compose interpolates it. `openssl rand -hex 24`
# gives a safe value.
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname (without scheme), used for NEXTAUTH_URL. The API URL baked
# into the web image comes from the repository variable of the same name
# (OPERATIONS.md, "Release build variables").
PUBLIC_HOSTNAME=luke.febos.local

# "true" when the site is served over HTTPS (secure session cookie).
# Optional, default false.
COOKIE_SECURE=false

# ── Release ───────────────────────────────────────────────────────────────────
# Version of the luke-api and luke-web images, without the leading `v`.
# Required: compose refuses to start without it. Releasing means setting the
# stack's Git reference to refs/tags/v<version> and this variable together,
# then redeploying (README.md, "Deployment").
LUKE_VERSION=3.0.0

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the 'luke' PostgreSQL user created by the postgres container.
# Generate: openssl rand -hex 24 (hex, not base64: the value is also placed inside
# DATABASE_URL, where a base64 `/` would break the URL)
# Compose-only: consumed by the postgres container and interpolated into the
# api container's DATABASE_URL by docker-compose.prod.yml. Never present in
# the api container's own environment, so assertEnvPolicy() never sees it.
POSTGRES_PASSWORD=change_me_strong_password

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Random secret used to sign/encrypt NextAuth session cookies. Required: the web
# container refuses to start without it in production.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_strong_secret

# ── S3 storage (SeaweedFS) ──────────────────────────────────────────────────────
# Admin credentials of the S3-compatible storage container. Not read by the api/web
# containers, but the storage gateway knows only this identity: Luke's own
# storage.s3.accessKey/secretKey (set via `Impostazioni → Storage`, stored encrypted
# in AppConfig) must hold these same values.
S3_ROOT_USER=change_me_admin_user
S3_ROOT_PASSWORD=change_me_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────
#
# The master key lives in the 'api_data' volume at /root/.luke/secret.key and is
# generated on first start. It decrypts the stored secrets and every backup, and
# the API's token secrets are derived from it. Back it up after the first start,
# and keep the copy as safe as the database:
#
#   docker cp luke-api-1:/root/.luke/secret.key ./secret.key.backup
#
# Uploaded files go where `Impostazioni → Storage` says: the S3 storage
# ('seaweedfs_data' volume) once it is configured, otherwise /root/.luke/storage
# in 'api_data'.
#
# CORS is intentionally disabled for direct browser → API requests.
# All API calls are proxied through the Next.js container (rewrites in next.config.js).
