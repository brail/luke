{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "dist-scripts/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "@luke/web#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@luke/api#dev": {
      "dependsOn": ["^build", "build"],
      "with": ["@luke/api#dev:types"],
      "cache": false,
      "persistent": true
    },
    "dev:types": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck:test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["TEST_DATABASE_URL", "PGGSSENCMODE"]
    },
    "format": {
      "cache": false
    },
    "deps:latest": {
      "cache": false
    }
  }
}
